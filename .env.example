MOLTBOOK_API_KEY=your_api_key_here
MOLTCHAN_API_KEY=your_moltchan_api_key_here
MOLTROAD_API_KEY=your_moltroad_api_key_here
MOLTX_API_KEY=your_moltx_api_key_here
CLAWTASKS_API_KEY=your_clawtasks_api_key_here
# Clawbr API (AI agent social network with debates)
# Register at https://www.clawbr.org/api/v1/agents/register
CLAWBR_API_KEY=agnt_your_clawbr_api_key_here
XAI_API_KEY=your_xai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Bankr API (for financial automation and fee claiming)
# Get your API key from https://bankr.bot/api
BANKR_API_KEY=bk_your_bankr_api_key_here
# 4claw API (for imageboard posting)
# Register at https://www.4claw.org
FOURCLAW_API_KEY=clawchan_your_api_key_here
# Token addresses
ALYBOT_TOKEN_ADDRESS=0x_your_token_address_here
# BASE Wallet (optional - only needed if bot will send transactions)
# Also used for Polygon (Polymarket) - same address on all EVM chains
BASE_WALLET_PRIVATE_KEY=your_base_wallet_private_key_here
# Pinata IPFS (for ERC-8004 agent card uploads)
# Get your JWT from https://www.pinata.cloud
PINATA_JWT=your_pinata_jwt_here
BASE_WALLET_PUBLIC_ADDRESS=your_base_wallet_public_address_here

# Moltbit.space (binary-encoded social network)
# Register at https://moltbit.space/.well-known/agent.json
MOLTBIT_OWNER_HANDLE=your_moltbit_owner_handle_here
MOLTBIT_AGENT_HANDLE=your_moltbit_agent_handle_here
MOLTBIT_OWNER_API_KEY=your_moltbit_owner_api_key_here
MOLTBIT_AGENT_API_KEY=your_moltbit_agent_api_key_here

# ============================================================
# AUTONOMOUS BRAIN CONFIGURATION
# ============================================================
# Enable 100% autonomous operation without manual commands
AUTO_START_BRAIN=true                    # Start brain automatically on boot
BRAIN_MODE=normal                        # conservative|normal|aggressive
BRAIN_AUTO_RESTART=true                  # Auto-restart brain on crashes
BRAIN_HEALTH_CHECK_MINUTES=5            # Health check frequency
BRAIN_MAX_RESTARTS_PER_HOUR=3           # Restart rate limit

# ============================================================
# AUTONOMOUS TRADING CONFIGURATION (SyMod-Validated)
# ============================================================
# SECURITY: Trading is DISABLED by default. Must use /trading_enable command.
# All trades validated by SyMod mathematical framework before execution.
TRADING_ENABLED=false                    # Must be explicitly enabled via Telegram
TRADING_MAX_POSITION_PCT=5.0            # Max 5% of capital per trade
TRADING_MIN_CONFIDENCE=0.8              # Min SyMod confidence (0.8 = conservative)
TRADING_MIN_RISK_REWARD=2.0             # Min 2:1 risk/reward ratio
TRADING_DAILY_LOSS_LIMIT_PCT=10.0      # Max 10% loss per day
TRADING_MAX_OPEN_POSITIONS=3            # Max 3 concurrent positions
TRADING_REQUIRE_GOLDEN_WINDOW=true     # Only trade in golden window
TRADING_REQUIRE_STABLE_FIELD=true      # Only trade when SyMod field is Stable
TRADING_MAX_IMPEDANCE=0.3               # Max impedance threshold